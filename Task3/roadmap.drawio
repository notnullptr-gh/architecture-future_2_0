        <mxCell id="nX252jZv9C1ik9F9Pw5Q-28" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;font&gt;Разворачивание стека: airflow + dremio + DLH&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;Этап необходимый для приобритения начальных компетенций по стеку и базового тестирования возможностей&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
